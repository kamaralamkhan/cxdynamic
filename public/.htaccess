<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If requested path is a directory and index.html exists, serve it
  DirectoryIndex index.html

  # Serve existing file or directory directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If directory with index.html exists, rewrite to it
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # Fallback to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Force fresh cache for icons & images so updates reflect instantly across CDN and browsers
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|png|jpe?g|webp|svg)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
